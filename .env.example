# Copy this file to .env and fill in your own local values.
# Never commit the real .env — it's in .gitignore for a reason.

# Database
DB_NAME=gst2_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# FastAPI
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8001

# Model paths (point these at wherever you store model weights locally)
LAYOUTLMV3_MODEL_PATH=./ml_models/layoutlmv3
LLAMA_MODEL_PATH=./ml_models/llama/llama-3-8b-q4.gguf
GOT_OCR_MODEL_PATH=./ml_models/got_ocr

# GPU settings
USE_GPU=True
GPU_DEVICE_ID=0

# Paths
MEDIA_ROOT=./media
TRAINING_DATA_PATH=./training_data

# Auto-retraining schedule
AUTO_TRAIN_EVERY_N=5
AUTO_TRAIN_EPOCHS=10
